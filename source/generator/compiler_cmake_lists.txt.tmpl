cmake_minimum_required(VERSION 3.16)
option(LEPUS_STATIC_LLVM "静态链接 LLVM 与 LLD 后端" OFF)
if(LEPUS_STATIC_LLVM AND CMAKE_HOST_WIN32)
    set(LEPUS_LLVM_SDK "${CMAKE_CURRENT_SOURCE_DIR}/build/dependencies/llvm/static-sdk" CACHE PATH "LLVM 静态开发库目录")
    set(CMAKE_C_COMPILER "${LEPUS_LLVM_SDK}/bin/gcc.exe" CACHE FILEPATH "匹配 SDK 的 C 编译器")
    set(CMAKE_CXX_COMPILER "${LEPUS_LLVM_SDK}/bin/g++.exe" CACHE FILEPATH "匹配 SDK 的 C++ 编译器")
    set(CMAKE_SYSROOT "${LEPUS_LLVM_SDK}" CACHE PATH "匹配 SDK 的 sysroot")
    set(CMAKE_EXE_LINKER_FLAGS_INIT "-static -fuse-ld=lld")
endif()
project(lepus_compiler LANGUAGES C CXX)
if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
    add_compile_options(-ffunction-sections -fdata-sections)
endif()
if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration" FORCE)
endif()
find_package(Threads REQUIRED)
include("${CMAKE_CURRENT_SOURCE_DIR}/tools/cmake_dependencies.cmake")
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)

set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/runtime/aot_sources.txt")
file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/runtime/aot_sources.txt" RUNTIME_CORE_SOURCES)
list(TRANSFORM RUNTIME_CORE_SOURCES PREPEND "${CMAKE_CURRENT_SOURCE_DIR}/runtime/")
add_library(lepus_vm_core STATIC ${RUNTIME_CORE_SOURCES})
file(GLOB LEPUS_ABI_SOURCES CONFIGURE_DEPENDS abi/*.c abi/*.cpp)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/caspp/core_sources.txt")
file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/caspp/core_sources.txt" LEPUS_CAS_SOURCES)
list(TRANSFORM LEPUS_CAS_SOURCES PREPEND "${CMAKE_CURRENT_SOURCE_DIR}/caspp/")
if(NO_LEPUS_STD OR NO_LEPUS_STD_CAS OR NO_LEPUS_BIG_INT)
    set(LEPUS_CAS_SOURCES "")
endif()
file(GLOB LEPUS_BIGNUM_C_SOURCES CONFIGURE_DEPENDS runtime/lepus_big*.c runtime_c/*.c)
add_library(lepus_host_records STATIC ${LEPUS_BIGNUM_C_SOURCES} ${LEPUS_ABI_SOURCES} ${LEPUS_CAS_SOURCES} ipage/sql.cpp ipage/dialect.cpp runtime/bigint.cpp runtime/bigfloat.cpp runtime/bigfloat_roots.cpp runtime/bigfloat_transcendental.cpp runtime/bigfloat_trigonometry.cpp
    "${LEPUS_SQLITE_DIR}/sqlite3.c" "${LEPUS_YYJSON_DIR}/src/yyjson.c" "${LEPUS_TOMLC17_DIR}/src/lepus_tomlc17.c" json/json.cpp toml/toml.cpp toml/toml_source.cpp lztext/lztext.cpp)
add_library(lepus_runtime STATIC runtime/ast.cpp runtime/ast_type.cpp runtime/ast_node.cpp runtime/ast_data.cpp runtime/preprocess.cpp runtime/system_arena.cpp
    "${LEPUS_MINIZ_DIR}/miniz_tinfl.c")
target_link_libraries(lepus_runtime PUBLIC lepus_vm_core lepus_host_records Threads::Threads)
set_source_files_properties("${LEPUS_YYJSON_DIR}/src/yyjson.c" "${LEPUS_TOMLC17_DIR}/src/lepus_tomlc17.c" PROPERTIES
    COMPILE_DEFINITIONS "YYJSON_DISABLE_FILE=1;YYJSON_DISABLE_WRITER=1;YYJSON_DISABLE_UTILS=1;YYJSON_DISABLE_INCR_READER=1;YYJSON_READER_DEPTH_LIMIT=256")
set_source_files_properties("${LEPUS_SQLITE_DIR}/sqlite3.c" PROPERTIES
    COMPILE_DEFINITIONS "SQLITE_THREADSAFE=1;SQLITE_OMIT_LOAD_EXTENSION=1")
set_source_files_properties("${LEPUS_MINIZ_DIR}/miniz_tinfl.c" PROPERTIES
    COMPILE_DEFINITIONS "MINIZ_NO_ARCHIVE_APIS;MINIZ_NO_DEFLATE_APIS")

# 反射的前端与运行时默认同时编入；单次编译使用 --no-reflection 关闭。
option(LEPUS_WITH_REFLECTION "启用注解与反射前端支持" ON)
option(RUNTIME_WITH_REFLECTION "启用注解与反射运行时支持" ON)
foreach(target lepus_vm_core lepus_host_records lepus_runtime)
    add_dependencies(${target} lepus_dependencies_check)
    target_include_directories(${target} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/runtime
        ${CMAKE_CURRENT_SOURCE_DIR}/json ${CMAKE_CURRENT_SOURCE_DIR}/toml ${CMAKE_CURRENT_SOURCE_DIR}/runtime_c ${CMAKE_CURRENT_SOURCE_DIR}/caspp/include
        "${LEPUS_SQLITE_DIR}" "${LEPUS_MINIZ_DIR}" "${LEPUS_YYJSON_DIR}/src" "${LEPUS_TOMLC17_DIR}/src")
    target_compile_definitions(${target} PUBLIC RUNTIME_BUILD_ONLY=1 LEPUS_CUSTOM_ALLOCATOR=1
        LEPUS_WITH_REFLECTION=$<BOOL:${LEPUS_WITH_REFLECTION}>
        RUNTIME_WITH_REFLECTION=$<BOOL:${RUNTIME_WITH_REFLECTION}>)
endforeach()

# 裁剪定义 PUBLIC 传播到前端和运行时，避免配置不一致。
foreach(feature NO_LEPUS_BIG_INT NO_LEPUS_BIG_FLOAT NO_LEPUS_DEFAULT_POOL NO_LEPUS_STD NO_LEPUS_STD_CAS NO_LEPUS_STD_MATH NO_LEPUS_STD_RANDOM NO_LEPUS_STD_REGEX NO_LEPUS_STD_SIGNAL NO_LEPUS_STD_JSON NO_LEPUS_STD_TOML NO_LEPUS_STD_BINARY NO_LEPUS_STD_LINALG NO_LEPUS_STD_PARSE NO_LEPUS_STD_PROCESS)
    option(${feature} "裁剪 ${feature} 对应功能" OFF)
    if(${feature})
        target_compile_definitions(lepus_runtime PUBLIC ${feature})
    endif()
endforeach()

file(GLOB LEPUS_MACRO_SOURCES CONFIGURE_DEPENDS macro/*.cpp literals/*.cpp syntax/*.cpp editor/*.cpp)
add_library(lepus_parser STATIC lepus_parser.cpp lepus_resource_cleanup.cpp lepus_generic.cpp lepus_lambda.cpp
    lepus_generic_closure.cpp lepus_package.cpp lepus_report.cpp lepus_aot.cpp lepus_aot_target.cpp lepus_aot_debug.cpp lepus_aot_llvm.cpp lepus_aot_runtime_assets.cpp lepus_temp.cpp lepus_digest.cpp lepus_library_manifest.cpp lepus_library_package.cpp lepus_library_templates.cpp lepus_library_bitcode.cpp lepus_library_tools.cpp lepus_native_tools.cpp lepus_native_objects.cpp lepus_linker.cpp lepus_archive_llvm.cpp lepus_assembler.cpp lepus_assembler_llvm.cpp lepus_precompiled.cpp lepus_stdlib_embedded.cpp)
target_sources(lepus_parser PRIVATE ${LEPUS_MACRO_SOURCES})
target_include_directories(lepus_parser PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
target_link_libraries(lepus_parser PUBLIC lepus_runtime)

option(LEPUS_STATIC_LLVM "静态链接 LLVM 与 LLD 后端" OFF)
if(LEPUS_STATIC_LLVM)
    if(NOT WIN32)
        message(FATAL_ERROR "当前静态 LLVM 分发仅验收 Windows x64")
    endif()
    set(LEPUS_LLVM_SDK "${CMAKE_CURRENT_SOURCE_DIR}/build/dependencies/llvm/static-sdk" CACHE PATH "LLVM 静态开发库目录")
    find_program(LEPUS_LLVM_CONFIG llvm-config.exe PATHS "${LEPUS_LLVM_SDK}/bin" NO_DEFAULT_PATH REQUIRED)
    set(LEPUS_LLVM_COMPONENTS core irreader passes x86codegen x86asmparser dtlto libdriver lto option windowsdriver windowsmanifest all-targets)
    execute_process(COMMAND "${LEPUS_LLVM_CONFIG}" --link-static --libs ${LEPUS_LLVM_COMPONENTS}
        OUTPUT_VARIABLE LEPUS_LLVM_LIBS OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE LEPUS_LLVM_CONFIG_STATUS)
    if(NOT LEPUS_LLVM_CONFIG_STATUS EQUAL 0)
        message(FATAL_ERROR "llvm-config 静态库查询失败")
    endif()
    execute_process(COMMAND "${LEPUS_LLVM_CONFIG}" --link-static --system-libs ${LEPUS_LLVM_COMPONENTS}
        OUTPUT_VARIABLE LEPUS_LLVM_SYSTEM_LIBS OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE LEPUS_LLVM_CONFIG_STATUS)
    if(NOT LEPUS_LLVM_CONFIG_STATUS EQUAL 0)
        message(FATAL_ERROR "llvm-config 系统库查询失败")
    endif()
    string(REPLACE "-lzstd.dll" "-lzstd" LEPUS_LLVM_SYSTEM_LIBS "${LEPUS_LLVM_SYSTEM_LIBS}")
    target_sources(lepus_parser PRIVATE tools/llvm_static_imports.cpp)
    target_include_directories(lepus_parser PRIVATE "${LEPUS_LLVM_SDK}/include/libxml2")
    target_compile_options(lepus_parser PUBLIC "--sysroot=${LEPUS_LLVM_SDK}")
    target_link_options(lepus_parser PUBLIC "--sysroot=${LEPUS_LLVM_SDK}" -static -fuse-ld=lld)
    if(NOT CMAKE_CXX_COMPILER MATCHES "${LEPUS_LLVM_SDK}/bin")
        message(FATAL_ERROR "静态预编译 SDK 必须使用其 bin/g++.exe 配置 CMake，禁止混用工具链")
    endif()
    separate_arguments(LEPUS_LLVM_LIBS NATIVE_COMMAND "${LEPUS_LLVM_LIBS}")
    separate_arguments(LEPUS_LLVM_SYSTEM_LIBS NATIVE_COMMAND "${LEPUS_LLVM_SYSTEM_LIBS}")
    set_source_files_properties(lepus_aot_llvm.cpp lepus_assembler_llvm.cpp lepus_archive_llvm.cpp PROPERTIES COMPILE_DEFINITIONS "LEPUS_STATIC_LLVM=1;LLVM_BUILD_STATIC"
        INCLUDE_DIRECTORIES "${LEPUS_LLVM_SDK}/include")
    target_link_directories(lepus_parser PUBLIC "${LEPUS_LLVM_SDK}/lib")
    target_link_libraries(lepus_parser PUBLIC -Wl,--start-group lldMinGW lldCOFF lldELF lldCommon
        ${LEPUS_LLVM_LIBS} ${LEPUS_LLVM_SYSTEM_LIBS} iconv bcrypt -Wl,--end-group)
endif()

add_executable(lepus lepus_main.cpp compiler_entry.cpp)
set_source_files_properties(lepus_main.cpp PROPERTIES COMPILE_DEFINITIONS LEPUS_FRONT_END_NO_MAIN=1)
if(WIN32)
    file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/VERSION" LEPUS_PROGRAM_VERSION LIMIT_COUNT 1)
    if(LEPUS_STATIC_LLVM)
        set(LEPUS_LLVM_VARIANT static)
    else()
        set(LEPUS_LLVM_VARIANT external)
    endif()
    set_target_properties(lepus PROPERTIES OUTPUT_NAME "lepus-${LEPUS_PROGRAM_VERSION}-llvm-${LEPUS_LLVM_VARIANT}-windows-x64")
endif()
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang" AND NOT APPLE)
    target_link_libraries(lepus PRIVATE -Wl,--start-group lepus_parser lepus_runtime lepus_vm_core lepus_host_records -Wl,--end-group)
else()
    target_link_libraries(lepus PRIVATE lepus_parser lepus_runtime)
endif()
configure_file(std/core.lep ${CMAKE_CURRENT_BINARY_DIR}/std/core.lep COPYONLY)
if(WIN32)
    target_link_libraries(lepus PRIVATE winhttp)
endif()
if(NOT WIN32)
    target_link_libraries(lepus PRIVATE m)
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_link_libraries(lepus PRIVATE dl)
endif()
if(MSVC)
    target_compile_options(lepus_runtime PRIVATE /utf-8)
    target_compile_options(lepus_vm_core PRIVATE /utf-8)
    target_compile_options(lepus_host_records PRIVATE /utf-8)
    target_compile_options(lepus_parser PRIVATE /utf-8 /bigobj)
    target_compile_options(lepus PRIVATE /utf-8)
endif()

# MinGW 调试/低优化构建的解析器与驱动可能超过普通 COFF 节数量上限。
if(MINGW AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_compile_options(lepus_vm_core PRIVATE -pthread)
    target_link_options(lepus PRIVATE -static -pthread)
    # GCC 11 的 COFF 字符串表在大型 O0 单元中也会溢出；保留 -g，Debug 的两个生成目标使用 O1。
    foreach(target lepus_parser lepus)
        target_compile_options(${target} PRIVATE -Wa,-mbig-obj $<$<CONFIG:Debug>:-O1>)
    endforeach()
endif()
