$macro RECORD<T>(name:ident) -> item {
struct name
{
    T value;

    static name create(T initial)
    {
        self.value = initial;
        return self;
    }
}
}

$RECORD<int64>(Box);
$RECORD<String>(Label);

$macro GETTER(gname:ident, field:ident) -> member {
int64 gname() { return self.field; }
}

struct Counter
{
    int64 value;
    $GETTER(read, value);
}

void main()
{
    Box box = Box::create(42);
    Label label = Label::create("Lepus");
    Counter counter;
    counter.value = 7;
    assert(box.value == 42 && label.value == "Lepus" && counter.read() == 7);
}
