$macro PLATFORM() -> expr {
$if ($system == "win") {
"win"
} $elif ($system == "linux") {
"linux"
} $else {
$system
}
}
$macro FLAG() -> expr {
$if ($!FEATURE_A) {
true
} $else {
false
}
}
void main() {
    assert($system == "win" || $system == "linux" || $system == "mac");
    assert($cpu == "amd64" || $cpu == "arm64" || $cpu == "arm32");
    assert($PLATFORM() == $system);
    assert($cpu != "unknown");
    assert($FLAG() == $!FEATURE_A);
    assert(!$!undefined_flag);
    println("target macros ok");
}
