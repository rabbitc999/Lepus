$macro vec<T:first>[first,...rest] -> {
    List<T> result;
    result.push(first);
    $for (element in rest) {
        result.push(element);
    }
    yield result;
}

void main()
{
    List<int64> result;
    result.push(99);
    List<int64> values = $vec[1, 2, 3];
    println("{} {} {}", values.len(), values.at(2), result.at(0));
}
