
$macro SWAP(mut &a, mut &b) -> {
int64 temporary = a;
a = b;
b = temporary;
}


$macro PAIR(v) -> {
int64 temporary = v;
int64 one = 1;
int64 nine = 9;
int64 ten = 10; int64 large = 11; int64 negative = 12;
assert(one + nine == 10 && ten == 10 && large == 11 && negative == 12);
println("pair={}", temporary);
}


$macro INNER(v) -> {
int64 temporary = v;
println("inner={}", temporary);
}

$macro OUTER(v) -> {
int64 temporary = v + 1;
println("outer={}", temporary);
    $INNER(v);
}


$macro REPORT(a) -> {
int64 temporary = a;
println("one={}", temporary);
}

$macro REPORT(a, b) -> {
int64 temporary = a + b;
println("two={}", temporary);
}


$macro SUM(...values) -> {
int64 temporary = 0;
$for (item in values) {
    temporary = temporary + item;
}
println("sum={}", temporary);
}


$replace SWAPV(mut &a, mut &b) { int64 temporary = a; a = b; b = temporary; }


$macro LITERAL -> {

println("literal={}", "$0 + $2");
}


$macro SHOW(x) -> {
    $stringify(x)
}

void main() {
    int64 tmp = 111;
    int64 x = 1;
    int64 y = 2;
    $SWAP(x, y);
    println("swap x={} y={} tmp={}", x, y, tmp);

    $PAIR(7);
    $PAIR(8);

    $OUTER(40);

    $REPORT(3);
    $REPORT(3, 4);

    $SUM(5, 6, 7);

    int64 p = 10;
    int64 q = 20;
    $SWAPV(p, q);
    println("replace p={} q={}", p, q);

    $LITERAL;
    println("show={}", $SHOW("$0"));
}
