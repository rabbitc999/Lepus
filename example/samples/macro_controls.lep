/* 编译期只检查完整语法类别和 ECMAScript 正则，未选分支不做语义检查。 */
$macro CLASSIFY(value) -> {
$match (value) {
ident => {
1
}
expr => {
2
}
_ => {
0
}
}
}
$macro NUMBER(value) -> {
$regex (value is "[0-9]+") {
value
} $else {
0
}
}
$macro POSITIVE(mut &out, ...rest) -> {
$for (item in rest) {
if (item > 0) { out += item; }
}
}
void main() {
    assert($CLASSIFY(name) == 1);
    assert($CLASSIFY(1 + 2) == 2);
    assert($NUMBER(42) == 42);
    assert($NUMBER(noSuchFunction()) == 0);
    int64 total = 0;
    $POSITIVE(total, 1, -2, 3);
    assert(total == 4);
    println("macros ok");
}
