$macro example(...A)(...B) -> {
    List<Any> listA;
    List<Any> listB;
    $for (var in A) {
    listA.push(var);
    }
    $for (var in B) {
    listB.push(var);
    }
    yield (listA, listB);
}

void main()
{
    let li = $example(1, "2", 3, 4, 1, 1)(3, 2, 4, 1);
    let listA = li[0];
    let listB = li[1];
    Any first = listA[0];
    Any second = listA[1];
    println("A={} B={}", listA.len(), listB.len());
    println("{} {}", tryGet<int64>(&first).unwrap(), tryGet<String>(&second).unwrap());
}
