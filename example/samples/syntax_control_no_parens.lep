/* 控制流条件的圆括号可选：if / elif / else if / while / while-else / for-in。
 * 三段式 for 仍要求圆括号；loop 本来就不带条件括号。 */
int64 classify(int64 value) {
    if value < 0 { return -1; }
    elif value == 0 { return 0; }
    else if value == 1 { return 1; }
    else { return 2; }
}

void main() {
    bool flag = true;
    int64 hits = 0;

    /* 无括号与带括号的条件表达式等价，elif 与 else if 同样支持无括号。 */
    if flag { hits++; }
    if (flag) { hits++; }
    if !flag { assert(false); } else { hits++; }
    if flag && hits == 3 { hits++; } else { assert(false); }
    if false { assert(false); } elif flag { hits++; } else { assert(false); }
    if false { assert(false); } else if flag { hits++; } else { assert(false); }
    assert(hits == 6);

    /* 条件值表达式。 */
    int64 selected = if flag { 10 } else { 20 };
    int64 chained = if false { 1 } elif flag { 2 } else { 3 };
    assert(selected == 10 && chained == 2);

    /* while 语句与 while-else 值表达式。 */
    int64 i = 0;
    while i < 3 { i++; }
    assert(i == 3);
    i = 0;
    while (i < 2) { i++; }
    assert(i == 2);
    int64 fallback = while false { 1 } else { 7 };
    int64 fallbackParens = while (false) { 1 } else { 7 };
    assert(fallback == 7 && fallbackParens == 7);

    /* for-in 的四种绑定形式，无括号与带括号各走一遍。 */
    int64 sum = 0;
    for x in range(1, 4) { sum += (int64)x; }
    for (let y in range(1, 4)) { sum += (int64)y; }
    int64 typed = 0;
    for int64 z in rangeEq(1, 3) { typed += z; }
    for (int64 w in rangeEq(1, 3)) { typed += w; }
    assert(sum == 12 && typed == 12);
    int64 last = for x in range(0, 3) {} else { (int64)x };
    assert(last == 2);

    /* loop 与三段式 for 的原有写法不变。 */
    int64 rounds = 0;
    loop { rounds++; if rounds == 2 { break; } }
    assert(rounds == 2);
    int64 counted = 0;
    for (int64 k = 0; k < 3; k++) { counted += k; }
    assert(counted == 3);

    assert(classify(-1) == -1 && classify(0) == 0);
    assert(classify(1) == 1 && classify(2) == 2);
    println("control flow without parentheses OK");
}
